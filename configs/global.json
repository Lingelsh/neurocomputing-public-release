{
  "variant": "global",
  "model": "models/codebert-base",
  "data_dir": "path/to/your/data",
  "output_dir": "path/to/your/output",
  "cache_dir": "path/to/your/cache",
  "device": "cuda",
  "local_files_only": true,
  "seed": 13,
  "batch_size": 8,
  "eval_batch_size": 8,
  "encoder_chunk_size": 8,
  "epochs": 3,
  "lr": 2e-05,
  "selection": "macro_matched_auc",
  "amp": true,
  "gradient_accumulation_steps": 8,
  "gradient_cache": false,
  "evals_per_epoch": 4,
  "patience": 0,
  "log_every_updates": 50,
  "warmup_fraction": 0.06,
  "grad_clip": 1.0,
  "weight_decay": 0.01
}