  "intercept_lr": 0.001,
  "weight_decay": 0.01,
  "batch_size": 1,
  "gradient_accumulation_steps": 64,
  "gradient_cache": true,
  "eval_batch_size": 1,
  "epochs": 3,
  "evals_per_epoch": 4,
  "patience": 0,
  "log_every_updates": 50,
  "warmup_fraction": 0.06,
  "grad_clip": 1.0,
  "rho": 0.0,
  "dro_eta": 0.01,
  "cfa_pairs": "reproduction/datasets/primevul/primevul_pairs.parquet",
  "lambda_inv": 1.0,
  "lambda_aux": 0.05,
  "lambda_rank": 0.0,
  "lambda_pair": 0.2,
  "length_tokenizer": null,
  "attention_from_scorer": false,
  "lambda_irm": 0.0,
  "cfa_prior_init": true,
  "irm_anneal_steps": 500,
  "reference_k": 32,
  "reference_mode": "empirical",
  "amp": true,
  "gradient_checkpointing": true,
  "encoder_checkpointing": true,
  "selection": "macro_matched_auc",
  "matched_delta": 0.05,
  "smoke_limit": null
}
