{
  "variant": "cfa",
  "data_dir": "data/primevul",
  "model": "microsoft/codebert-base",
  "tokenizer": null,
  "output_dir": "runs/primevul-cfa",
  "cache_dir": "runs/cache",
  "seed": 13,
  "device": "cuda",
  "local_files_only": false,
  "max_input_tokens": 512,
  "window_tokens": 128,
  "stride_tokens": 64,
  "encoder_chunk_size": 8,
  "attention_hidden": 128,
  "length_hidden": 32,
  "lr": 2e-05,
